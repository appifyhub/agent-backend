#!/usr/bin/env sh

. "$(dirname "$0")/messages"

if [ ! -f "Pipfile" ]; then
    echowarn "WARN:     No 'Pipfile' found. This script must be run from the project root!" >&2
    echoerr "ERROR:    Exiting..." -n >&2
    exit 1
fi

if [ "$1" != "-y" ]; then
    echoinfo "Have you applied all previous schemas to the database? (y/n) "
    read -r RESPONSE
    if [ "$RESPONSE" != "Y" ] && [ "$RESPONSE" != "y" ]; then
        echowarn "WARN:     Let's make sure that's done first."
        echoerr "ERROR:    Exiting..." -n >&2
        exit 1
    fi
fi

DB_HOST="${POSTGRES_HOST:-localhost}"
DB_PORT=5432
DB_USER="${POSTGRES_USER:-root}"
MAX_RETRIES=7
RETRY_INTERVAL=5
RETRIES=0

echoinfo "INFO:     Waiting for database to be ready..." -n
while [ "$RETRIES" -lt "$MAX_RETRIES" ]; do
    if pg_isready -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -q 2>/dev/null; then
        break
    fi
    RETRIES=$((RETRIES + 1))
    echowarn "WARN:     Database not ready (attempt $RETRIES/$MAX_RETRIES). Retrying in ${RETRY_INTERVAL}s..."
    sleep "$RETRY_INTERVAL"
done
if [ "$RETRIES" -eq "$MAX_RETRIES" ]; then
    echoerr "ERROR:    Database did not become ready after $MAX_RETRIES attempts." -n >&2
    exit 1
fi

echoinfo "INFO:     Running the database upgrade..." -n
pipenv run alembic upgrade head

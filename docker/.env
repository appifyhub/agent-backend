# local-only example values; replace secrets before deploying

POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASS=local-db-password

SHLINK_DB_NAME=shlink
SHLINK_DB_USER=shlink
SHLINK_DB_PASSWORD=local-shortener-db-password
SHLINK_PORT=8081
SHLINK_DOMAIN=localhost:8081
SHLINK_HTTPS_ENABLED=false
URL_SHORTENER_BASE_URL=http://shortener:8080
URL_SHORTENER_API_KEY=local-shortener-key

API_PORT=8080
API_KEY=local-api-key
JWT_SECRET_KEY=local-jwt-secret-change-me
TOKEN_ENCRYPT_SECRET=local-encryption-secret-change-me
PUBLIC_API_BASE_URL=http://localhost:8080
BACKOFFICE_URL_BASE=http://localhost:5173
WEBSITE_URL=http://localhost:5173
PARENT_ORGANIZATION="Example Organization"
THE_AGENT_ISSUES_REPO=appifyhub/agent-backend
THE_AGENT_ISSUE_TEMPLATES_PATH=/app/src/templates

# leave S3 and Uploadcare unconfigured to use the persistent local attachment volume
S3_BASE_URL=
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_PRIVATE_KEY=

# add provider keys and integration credentials from src/util/config.py as needed
# PLATFORM_OPEN_AI_KEY=
# TELEGRAM_BOT_TOKEN=

